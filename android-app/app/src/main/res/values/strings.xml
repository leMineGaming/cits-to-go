    <!-- CAM Broadcast page -->
    <string name="cam_interval_range">Allowed CAM range: %1$d–%2$d ms</string>
    <string name="cam_interval_range_stress">Stress-test range: %1$d–%2$d ms. The standard allows %3$d–%4$d ms.</string>
    <string name="cam_interval_stress_title">Outside the C-ITS standard</string>
    <!-- The hyphen belongs to the standard's name, it is no range, so the dash rule does not apply. -->
    <string name="cam_interval_stress_body" tools:ignore="TypographyDashes">An interval below %1$d ms broadcasts more than the 10 CAMs per second that ETSI EN 302 637-2 allows. This is explicitly against the standard, it will most likely overload the other participants in range with a flood of CAMs, and it is most likely illegal on public roads. Stress test only, in a shielded and authorised environment.</string>
    <string name="cam_interval_stress_from_debug_menu">This range was unlocked by enabling Debug in the Settings.</string>
    <string name="cam_interval_stress_needs_debug_menu">Start sends %1$d ms instead. This range needs Debug enabled in the Settings.</string>

