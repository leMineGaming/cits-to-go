    <string name="about_source_code_label">Source code on Codeberg</string>
    <string name="about_opentrafficmap_label">OpenTrafficMap</string>
    <string name="about_licences_title">Open-source licences</string>
    <string name="about_licences_map_libraries">The Map page uses MapLibre Native and the libraries it brings along. Their licence texts follow below.</string>
    <string name="about_licences_map_data">Map tiles from OpenFreeMap, built with OpenMapTiles from OpenStreetMap data, available under the Open Database Licence.</string>
